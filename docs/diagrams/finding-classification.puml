@startuml
' Rendered by scripts/build-diagrams.sh. Edit this file, never the SVG beside it.
'
' One neutral grey on a transparent background, so a single SVG stays legible on
' the light theme and the dark one. Nothing here picks a palette, which is what
' lets the site own its own colors.
<style>
document {
  BackgroundColor transparent
}
activityDiagram {
  BackgroundColor transparent
  LineColor #888888
  FontColor #888888
  FontName Helvetica
  FontSize 13

  activity {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  diamond {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  circle {
    BackgroundColor #888888
    LineColor #888888
  }
  note {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  arrow {
    LineColor #888888
    FontColor #888888
  }
}
</style>
skinparam shadowing false

start
:One finding;

if (Who can fix it?) then (the project alone)
  :Document fault;
  :Exit 1, the hard gate;
  note right
    Per run, not per finding: a
    document fault always wins when
    both are present, so the harder
    failure is never buried under
    the softer one's count.
  end note
  stop
else (us, eventually)
  :Package limit;

  if (Is the support level Deferred?) then (yes)
    :Reported, and never gates.\nOur schedule is not their defect;
    stop
  else (no)
  endif

  if (Acknowledged in configuration?) then (yes)
    :Reported in its own section,\nwith no effect on the exit code;
    stop
  else (no)
    :Exit 2, the softer signal;
    stop
  endif
endif
@enduml
