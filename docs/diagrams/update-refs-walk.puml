@startuml
' Rendered by scripts/build-diagrams.sh. Edit this file, never the SVG beside it.
'
' One neutral grey on a transparent background, so a single SVG stays legible on
' the light theme and the dark one. Nothing here picks a palette, which is what
' lets the site own its own colors.
<style>
document {
  BackgroundColor transparent
}
activityDiagram {
  BackgroundColor transparent
  LineColor #888888
  FontColor #888888
  FontName Helvetica
  FontSize 13

  activity {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  diamond {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  circle {
    BackgroundColor #888888
    LineColor #888888
  }
  note {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  arrow {
    LineColor #888888
    FontColor #888888
  }
}
</style>
skinparam shadowing false

start
:One $ref that names a URL;

if (Is the host on the allowlist?) then (no)
  :Refuse, exactly as the root\ndocument would have;
  stop
else (yes)
endif

if (Is that URL already being fetched?) then (yes)
  :Refuse. The chain closed on itself\ninstead of recursing forever;
  stop
else (no)
endif

:Fetch it;

:Walk every $ref it names\nthe same way;
note right
  This diagram, one hop deeper.
  Nothing about depth is
  special-cased.
end note

if (Did every reference inside it resolve?) then (yes)
  :Rewrite its own $refs to their\nlocal vendored siblings, and write it;
  :Point the parent's $ref\nat the local path;
  stop
else (no)
  :Write it exactly as the\nserver returned it;
  :Remove the parent's $ref\nrather than rewriting it;
  note right
    Both halves, or the next build finds
    no remote $ref left to complain about
    and generates a contract quietly
    missing the schema.
  end note
  stop
endif
@enduml
