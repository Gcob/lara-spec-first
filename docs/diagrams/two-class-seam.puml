@startuml
' Rendered by scripts/build-diagrams.sh. Edit this file, never the SVG beside it.
' The colours, the fonts and the transparent ground come from palette.iuml.
!include palette.iuml


' The spot circle on a class and the coloured dot on a member are drawn from
' PlantUML's own palette, hardcoded, and one of them paints its letter black:
' invisible on the dark theme, and off the single grey this set draws in. Both
' are turned off rather than restyled.
hide circle
skinparam classAttributeIconSize 0
hide empty members

' A period in a package name is a namespace separator to PlantUML, which splits
' "Generated. Rewritten..." into two nested boxes. Turned off so a label is a label.
set separator none

package "Shipped by the package" $shippedInk {
  abstract class SpecController $shippedInk {
    +routeAction()
    +middleware()
  }
  interface HasModel $shippedInk {
    +getModelClass()
    +getQuery()
  }
  class InteractsWithModel <<trait>> $shippedInk {
    +getQuery()
  }
  package "One per detected semantic, all empty" $shippedInk {
    interface CreatesResource $shippedInk
    interface ShowsResource $shippedInk
    interface ListsResources $shippedInk
    interface UpdatesResource $shippedInk
    interface DeletesResource $shippedInk

    ' Laid out in one row on purpose: five empty boxes let free would
    ' spread across the package and leave it mostly white space.
    CreatesResource -[hidden]right- ListsResources
    ListsResources -[hidden]right- UpdatesResource
    UpdatesResource -[hidden]right- DeletesResource
    DeletesResource -[hidden]right- ShowsResource
  }
}

package "Generated, rewritten on every build" $generatedInk {
  class "Generated\\Controllers\\UserController" as Parent $generatedInk {
    +routeAction(User): UserDto
    +getModelClass(): string
  }
}

package "Yours, created once and never touched again" $yoursInk {
  class "Controllers\\UserController" as Child $yoursInk {
    +routeAction(User): UserDto
  }
}

SpecController <|-- Parent
HasModel <|.. Parent
InteractsWithModel <.. Parent : use
ShowsResource <|.. Parent
Parent <|-- Child

note right of Parent
  final unless the operation
  declares x-controller.
  getModelClass() is the only
  member the build writes.
end note

note bottom of Child
  routes.php points here when the file
  exists, and at the generated parent
  when it does not. Decided at build
  time, so route:cache keeps working.
end note

note top of ShowsResource
  The build implements the one its
  detection produced, and none at all
  when it read no semantic.
end note

note as Disclosure
  Working names, every one of them, and
  public API from the first release on.
  Read this to see how the pieces fit,
  not as a settled contract.
end note
@enduml
