@startuml
' Rendered by scripts/build-diagrams.sh. Edit this file, never the SVG beside it.
' The colours, the fonts and the transparent ground come from palette.iuml.
!include palette.iuml


start
:spec:make, for one operation;

if (Does the operation declare x-controller?) then (no)

  if (Is the document vendored?) then (yes)
    :Refuse. The next fetch\nwould overwrite the line; <<refusal>>
    stop
  else (no)
  endif

  if (Can a line be placed under the operation?) then (no)
    :Print the block, and say where\nit could not work out the depth; <<refusal>>
    note right
      Flow-style, JSON, or a Path Item
      that is a $ref into another file.
    end note
    stop
  else (yes)
  endif

  :Print the block and offer\nto insert it, defaulting to no;

  if (Accepted?) then (no)
    :Leave the document alone; <<refusal>>
    stop
  else (yes)
  endif

  :Insert on a temporary copy;
  :Read the copy back through\nthe normal reading pipeline;

  if (Do the operations match, but for the extension?) then (no)
    :Print the block instead,\nand write nothing; <<refusal>>
    stop
  else (yes)
  endif

  :The copy replaces the original; <<yours>>

else (yes)
endif

if (Does the class file already exist?) then (yes)
  :Leave it exactly as it is,\nand say so; <<refusal>>
  stop
else (no)
endif

:Write the class: the extends, the comment,\nand routeAction calling the parent; <<yours>>
:Run spec:build, so the parent exists\nand the route points here;
stop
@enduml
