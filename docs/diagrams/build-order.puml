@startuml
' Rendered by scripts/build-diagrams.sh. Edit this file, never the SVG beside it.
'
' One neutral grey on a transparent background, so a single SVG stays legible on
' the light theme and the dark one. Nothing here picks a palette, which is what
' lets the site own its own colors.
<style>
document {
  BackgroundColor transparent
}
activityDiagram {
  BackgroundColor transparent
  LineColor #888888
  FontColor #888888
  FontName Helvetica
  FontSize 13

  activity {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  diamond {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  circle {
    BackgroundColor #888888
    LineColor #888888
  }
  note {
    BackgroundColor transparent
    LineColor #888888
    FontColor #888888
  }
  arrow {
    LineColor #888888
    FontColor #888888
  }
}
</style>
skinparam shadowing false

start
:spec:build;

if (Is every vendored reference on disk?) then (no)
  :Stop, naming --update-refs;
  note right
    The build never reaches
    the network on its own.
  end note
  stop
else (yes)
endif

:Read the document;
note right
  The five steps of the reading
  pipeline, drawn on their own
  in openapi-support.md.
end note

:Normalize in memory;

if (Did reading collect a document fault?) then (yes)
  :Stop before the generator.\nNothing is written;
  stop
else (no)
endif

:Compare against the previously committed\nspecification, read from git;
note right
  After 1.0, not shipped:
  this step and the refusal
  below it.
end note

if (Does the change break a stable operation?) then (yes)
  :Stop, naming the info.version\nbump that would allow it;
  stop
else (no)
endif

:Plan every file in memory;
:Write;
:Prune what the contract no longer has;
note right
  Only a file carrying the marker
  is ever removed.
end note

stop
@enduml
