# EditorConfig — https://editorconfig.org
#
# Keeps formatting identical across machines and editors. PhpStorm, VS Code and
# Zed read this natively. It travels with the repository, so it applies on macOS,
# Ubuntu and WSL alike, without depending on any local editor configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# PHP: the width scripts/format-docblocks.php reflows docblock prose to. Pint has no
# rule for it, so this is where the number lives, the same way Prettier reads it
# for Markdown below.
#
# docblock_min_description_width is that script's own key, and editors ignore it. A
# @param, @return, @throws or @var continues under the start of its description, so
# a long type and name leave little room. A tag whose description has fewer columns
# than this left on its first line is "cramped": `composer format:docblocks:check`
# warns about it, `composer format:docblocks:report` lists them all, and neither
# ever fails.
[*.php]
max_line_length = 120
docblock_min_description_width = 40

# Markdown: two trailing spaces are a hard line break, so they must survive.
[*.md]
trim_trailing_whitespace = false
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.neon]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
